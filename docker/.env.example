# Docker-only environment for `docker compose`.
#
# Copy this file to docker/.env and fill in OPENAI_API_KEY. docker/.env is gitignored.
#
# This is DELIBERATELY separate from backend/.env (which keeps its localhost defaults for
# running the app outside Docker via run_all.sh / manual uvicorn) — the two are not meant
# to be merged. Every URL below uses a Docker Compose *service name*, not localhost,
# because containers cannot reach each other via localhost.

OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
RAG_MODEL=gpt-4o-mini
MAX_SCENARIOS=10
PRICE_PER_1K_TOKENS=0.0004

# --- PostgreSQL ---
# Single database, single source of truth: backend and worker both read DATABASE_URL
# from this same file, so they can never point at two different databases.
POSTGRES_DB=agentshield
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=agentshield
DATABASE_URL=postgresql://agentshield:agentshield@postgres:5432/agentshield

# --- Temporal ---
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentshield
AGENT_CONCURRENCY=3
WORK_CONCURRENCY=9
WORKFLOW_TASK_CONCURRENCY=100

# --- Sample agents (container-to-container, by Docker service name) ---
SAMPLE_RAG_BOT_URL=http://sample-rag-bot:8002/chat
BANKING_BOT_URL=http://banking-bot:8003/chat
HR_BOT_URL=http://hr-bot:8004/chat
INSURANCE_BOT_URL=http://insurance-bot:8005/chat
AIRLINE_BOT_URL=http://airline-bot:8006/chat
TELECOM_BOT_URL=http://telecom-bot:8007/chat

# --- Frontend ---
# Fetched from the BROWSER, not from inside a container — must stay a host-reachable
# address (backend's published port), never a Docker service name.
NEXT_PUBLIC_API_URL=http://localhost:8000
