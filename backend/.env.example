# Copy this file to .env and fill in your real key. .env is gitignored.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
SAMPLE_BOT_URL=http://localhost:8001/chat
SAMPLE_RAG_BOT_URL=http://localhost:8002/chat

# PostgreSQL. Create the db once with: createdb agentshield
DATABASE_URL=postgresql://localhost:5432/agentshield

# --- Tunables (optional; these are the built-in defaults) ---
# Blended price used to estimate cost = total_tokens / 1000 * PRICE_PER_1K_TOKENS
PRICE_PER_1K_TOKENS=0.0004
# Model the sample RAG agents use
RAG_MODEL=gpt-4o-mini
# Max scenarios per run (keeps a live run fast)
MAX_SCENARIOS=10
