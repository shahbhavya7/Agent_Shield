# Copy this file to .env and fill in your real key. .env is gitignored.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
SAMPLE_BOT_URL=http://localhost:8001/chat
SAMPLE_RAG_BOT_URL=http://localhost:8002/chat

# PostgreSQL. Create the db once with: createdb agentshield
DATABASE_URL=postgresql://localhost:5432/agentshield

# --- Tunables (optional; these are the built-in defaults) ---
# Blended price used to estimate cost = total_tokens / 1000 * PRICE_PER_1K_TOKENS
PRICE_PER_1K_TOKENS=0.0004
# Model the sample RAG agents use
RAG_MODEL=gpt-4o-mini
# Max scenarios per run (keeps a live run fast)
MAX_SCENARIOS=10
# Voice modality (Phase 2B AI Caller): STT/TTS models bridging a text scenario turn
# onto a real voice-contract endpoint. Same defaults as backend/sample_voice_bot.
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=alloy

# --- Temporal (optional) ---
# Only the worker and code that explicitly asks for a client use these. The app boots
# and all tests pass with no Temporal server running.
# Start the dev server with:  temporal server start-dev   (UI: http://localhost:8233)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentshield
# How many agents run at once, and the ceiling on in-flight scenario/judge/fix work
AGENT_CONCURRENCY=3
WORK_CONCURRENCY=9
